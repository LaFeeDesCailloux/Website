---
import { Image } from "astro:assets"
import CheminDeVie from "@assets/img/chemins_de_vie/main.webp"
import BraceletsTherapeutiques from "@assets/img/bracelets_therapeutiques/main.webp"
import Pendules from "@assets/img/pendules/main.webp"
import PendentifsEtColliers from "@assets/img/pendentifs_et_colliers/main.webp"
import DrusesEtGeodes from "@assets/img/druses_et_geodes/main.webp"
import PierresRoulees from "@assets/img/pierres_roulees/main.webp"
---

<article class="content" id="mes-realisations">
    <h2>Mes réalisations</h2>
    <section>
        <a href="/realisations/chemins-de-vie">
            <Image src={CheminDeVie} alt="Chemin de vie" />
            <div>
                <h3>Chemins de vie</h3>
                <p>
                    A partir de 45€<br />
                    jusqu'à 60€
                </p>
            </div>
        </a>
        <a href="/realisations/bracelets-therapeutiques">
            <Image src={BraceletsTherapeutiques} alt="Bracelets thérapeutiques" />
            <div>
                <h3>Bracelets thérapeutiques</h3>
                <p>A partir de 18€</p>
            </div>
        </a>
        <a href="/realisations/pendules">
            <Image src={Pendules} alt="Pendules" />
            <div>
                <h3>Pendules</h3>
                <p>A partir de 22€</p>
            </div>
        </a>
        <a href="/realisations/pendentifs-et-colliers">
            <Image src={PendentifsEtColliers} alt="Pendentifs et Colliers" />
            <div>
                <h3>Pendentifs et Colliers</h3>
                <p>A partir de 8€</p>
            </div>
        </a>
        <a href="/realisations/druses-et-geodes">
            <Image src={DrusesEtGeodes} alt="Druses et Géodes" />
            <div>
                <h3>Druses et Géodes</h3>
                <p>A partir de 35€</p>
            </div>
        </a>
        <a href="/realisations/pierres-roulees">
            <Image src={PierresRoulees} alt="Pierres roulées" />
            <div>
                <h3>Pierres roulées</h3>
                <p>A partir de 5€</p>
            </div>
        </a>
    </section>
</article>

<style>
    section {
        display: grid;
        grid-template-columns: repeat(1, 1fr);
        align-items: center;
        justify-items: stretch;
        gap: 2rem;

        a {
            aspect-ratio: 1.5/1;
            border-radius: var(--border-radius);
            position: relative;
            overflow: hidden;
            box-shadow: rgba(0, 0, 0, 0) 0 0 0 0, rgba(0, 0, 0, 0) 0 0 0 0,
            rgba(0, 0, 0, 0.25) 0 25px 50px -12px;

            img {
                width: 100%;
                height: 100%;
                object-fit: cover;
                transform: scale(1.005);
                transition: transform 250ms;
            }

            div {
                height: 56px;
                backdrop-filter: blur(var(--blur));
                padding: 1.6rem;
                display: flex;
                flex-direction: column;
                align-items: center;
                justify-content: center;
                gap: 0.75rem;
                position: absolute;
                left: 0;
                bottom: 0;
                right: 0;
                text-align: center;
                background-color: rgba(0, 0, 0, 0.5);
                color: white;

                h3 {
                    font-size: 1.2em;
                    font-family: var(--title-font);
                }

                p {
                    display: none;
                }
            }

            &:hover {
                img {
                    transform: scale(1.03);
                }

                div {
                    opacity: 1;
                }
            }
        }

        @media (min-width: 600px) {
            grid-template-columns: repeat(2, 1fr);

            a {
                aspect-ratio: 1.2/1;
            }
        }

        @media (min-width: 900px) {
            grid-template-columns: repeat(3, 1fr);

            a div {
                transition: opacity 250ms;
                opacity: 0;
                top: 0;
                height: unset;
                background-color: rgba(255, 255, 255, 0.5);
                color: var(--global-text-color);

                h3 {
                    font-size: 1.6em;
                }

                p {
                    font-size: 1.22em;
                    display: unset;
                }
            }
        }

        @media (min-width: 1200px) {
            gap: 3rem;
        }
    }
</style>
