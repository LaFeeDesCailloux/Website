---

<Banniere titre="Pendentifs et Colliers" image={Banner} />

  <Description>
    <section>
        <div>
            <p>
                Tout comme la <a href="/realisations/pierres-roulees">pierre roulée</a>,
                le pendentif et le collier sont des bijoux qui vous sont bénéfiques en
                vous apportant les énergies relatives au minéral choisi. Ils restent
                cependant plus facile à porter en restant en permanence à votre
                contact.
            </p>
            <p>
                Tout comme les autres pierres et cristaux, il doit être purifié ou
                rechargé à la lune ou au soleil en fonction de sa composition.
            </p>
        </div>
        <Image class="blob" src={Pendentif} alt="Pendentif" />
    </section>
</Description>

<EntretenirPierres />

<Galerie client:idle dossier="pendentifs_et_colliers/galerie/" images={images} />

<Contact />

<script>
    import { generateBlobs, toggleBlobs } from "@assets/blobGenerator"

    setTimeout(generateBlobs, 200)
    setInterval(generateBlobs, 12000)
    window.addEventListener("resize", toggleBlobs)
</script>
