---
import { Image } from "astro:assets"
import Banniere from "@components/Banniere.astro"
import Banner from "@assets/img/druses_et_geodes/banner.webp"
import Description from "@components/Description.astro"
import Druse from "@assets/img/druses_et_geodes/description_1.webp"
import Geode from "@assets/img/druses_et_geodes/description_2.webp"
import EntretenirPierres from "@components/EntretenirPierres.astro"
import Galerie from "@components/Galerie.vue"
import Contact from "@components/Contact.astro"
import type { GalleryImage } from "src/types"

const images: GalleryImage[] = [
    {
        src: "DSC06737.webp",
        title: "Cristal de roche"
    },
    {
        src: "IMG_20211023_174234.webp",
        title: "Améthyste"
    },
    {
        src: "IMG_20211023_180852.webp",
        title: "Cristal de roche"
    },
    {
        src: "IMG_20211024_150807.webp",
        title: "Améthyste"
    },
    {
        src: "IMG_20211024_151152.webp",
        title: "Cristal de roche"
    },
    {
        src: "IMG_20211024_153524.webp",
        title: "Cristal de roche"
    }
]
---

<Banniere titre="Druses et Géodes" image={Banner} />

<Description>
    <section>
        <div id="description">
            <p>
                Outre leurs beautés, les géodes et les druses sont également bien
                utiles.
            </p>
            <p>
                Elles vous permettent de recharger en quelques heures vos pierres :
            </p>
            <ul>
                <li>Bracelets ;</li>
                <li>Pierres roulées ;</li>
                <li>Pendules ;</li>
                <li>Pendentifs ;</li>
                <li>Etc.</li>
            </ul>
            <p>Il suffit d’y déposer vos minéraux à l'intérieur.</p>
        </div>
        <Image class="blob" src={Druse} alt="Druse" />
    </section>

    <section>
        <div>
            <p>
                Les Géodes sont creuses et peuvent recevoir vos bracelets et pierres,
                tout comme les druses.<br />
                Cependant, ces dernières sont tapissées de cristaux sur leur dessus
                permettant d'autres types d'utilisations.
            </p>
            <h3>Quelques exemples :</h3>
            <ul>
                <li>
                    Une druse en améthyste permet d’apporter de la sérénité à la pièce
                    dans laquelle elle est exposée ;
                </li>
                <li>
                    Les géodes en cristal de roche peuvent purifier et recharger vos
                    différentes pierres ;
                </li>
                <li>Les géodes en cristal de roche peuvent purifier un lieu ;</li>
                <li>Etc.</li>
            </ul>
        </div>
        <Image class="blob" src={Geode} alt="Géode" />
    </section>
</Description>

<EntretenirPierres />

<Galerie client:idle dossier="druses_et_geodes/galerie/" images={images} />

<Contact />

<script>
    import { generateBlobs, toggleBlobs } from "@assets/blobGenerator"

    setTimeout(generateBlobs, 200)
    setInterval(generateBlobs, 12000)
    window.addEventListener("resize", toggleBlobs)
</script>

<style lang="scss">
    #description {
        p:nth-of-type(2) {
            margin-bottom: 0;
        }

        p:last-of-type {
            margin-top: 1rem;
        }
    }
</style>
