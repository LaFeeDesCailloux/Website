---
import Layout from "@layouts/Layout.astro"
import BanniereGlobale from "@components/BanniereGlobale.astro"
import Lithotherapie from "@components/Lithotherapie.astro"
import Realisations from "@components/Realisations.astro"
import APropos from "@components/A-propos.astro"
import Avis from "@components/Avis.astro"
import Contact from "@components/Contact.astro"
---

<Layout>
	<BanniereGlobale />
	<Lithotherapie />
	<Realisations />
	<APropos />
	<Avis />
	<Contact />
</Layout>

<script>
	import { generateBlobs } from "@assets/blobGenerator"

	setTimeout(generateBlobs, 200)
	setInterval(generateBlobs, 12000)
</script>
